# /etc/default/minio
# ------------------------------------------------------------------------------
# MinIO Root Credentials
# ------------------------------------------------------------------------------
MINIO_ROOT_USER="myminioadmin"
MINIO_ROOT_PASSWORD="superSecretPassword"

# ------------------------------------------------------------------------------
# Distributed cluster endpoints.
# Each line references a node and the path to its data directory.
# If mgmtnode has no disk, you can either omit it or reference a small dir on mgmtnode.
# ------------------------------------------------------------------------------
MINIO_VOLUMES="
  http://mgmtnode/data/minio
  http://worker1/data/minio
  http://worker2/data/minio
  http://worker3/data/minio
  http://worker4/data/minio
"

# ------------------------------------------------------------------------------
# MinIO listening ports for S3 + console.
# ------------------------------------------------------------------------------
MINIO_OPTS="--address :9000 --console-address :9001"
