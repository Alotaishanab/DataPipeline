MINIO_ROOT_USER=myminioadmin
MINIO_ROOT_PASSWORD=superSecret123

# The official distributed mode:
# Each node references all 5 endpoints
# (If mgmtnode has no real disk, you can still reference mgmtnode/data/minio, 
#  it just won't store much, or skip it.)
MINIO_VOLUMES="{{ distributed_volumes | trim }}"

# Listen on all interfaces for S3 + console
MINIO_OPTS="--address :9000 --console-address :9001"
