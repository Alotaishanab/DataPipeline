# /etc/minio/minio.conf – Managed by Ansible

# Distributed drive endpoints (all nodes in the cluster)
MINIO_VOLUMES={{ minio_volumes | trim }}

# MinIO server options: Bind API to the specified port (9000 in this example)
MINIO_OPTS="--address :{{ minio_default_port }} /mnt/data"

# Credentials and region settings
MINIO_ROOT_USER="{{ minio_root_user }}"
MINIO_ROOT_PASSWORD="{{ minio_root_password }}"
MINIO_SITE_REGION="eu-west-1"
